# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-or-anon-key

# Embedding model (must match the model used to embed stored chunks)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# "cpu" or "cuda" (falls back to cpu automatically if cuda isn't available)
EMBEDDING_DEVICE=cpu

# Retrieval defaults
DEFAULT_LAB_ID=lab_5
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.4

# LLM backend: "mock" or "openai_compatible"
LLM_BACKEND=mock
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=placeholder-model
LLM_TIMEOUT_SECONDS=30

# API
API_REQUEST_TIMEOUT_SECONDS=30
