# Copy to Intelligence/.env and fill in. NEVER commit .env.

# Supabase (Project Settings -> API). Service-role key: the tables use RLS with no policies.
# Server-side only - never put this key in the Human Interface frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM: mock | anthropic | openai_compatible
LLM_BACKEND=mock
LLM_MODEL=
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval tuning (tune with the eval set)
RAG_MATCH_COUNT=5
RAG_MIN_SIMILARITY=0.3
RAG_MAX_HISTORY_TURNS=6
RAG_LOG_QUERIES=true

# Comma-separated origins allowed to call the API (Human Interface dev server)
ALLOWED_ORIGINS=http://localhost:3000
